{
  "name": "trace-x",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-first financial crime and digital infrastructure investigation workspace",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,green \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/analysis.test.ts tests/ingestion.test.ts tests/api.test.ts",
    "test:ui": "playwright test",
    "package:submission": "tsx scripts/package-submission.ts",
    "format": "prettier --write src server shared tests scripts docs README.md *.json *.ts index.html"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.5",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@xyflow/react": "^12.8.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "pdfjs-dist": "^6.2.108",
    "pdfkit": "^0.17.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/dagre": "^0.7.53",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/pdfkit": "^0.17.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "vite": "^6.3.6",
    "vite-plugin-singlefile": "^2.3.0"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
